# Supabase credentials template
# Copy this file to .streamlit/secrets.toml and replace with your actual Supabase project keys.
# NEVER commit .streamlit/secrets.toml to version control.

# ==============================================================================
# RUNTIME APPLICATION CONFIGURATION (Used by Streamlit App with RLS Enforced)
# ==============================================================================
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key-here"

# SHA-256 hash of the Teacher/Admin password used for authorized word overrides.
# Example: SHA-256 for 'teacher123' is 'cde383eee8ee7a4400adf7a15f716f179a2eb97646b37e089eb8d6d04e663416'
TEACHER_OVERRIDE_HASH = "cde383eee8ee7a4400adf7a15f716f179a2eb97646b37e089eb8d6d04e663416"

# ==============================================================================
# DEVELOPER-ONLY OFFLINE CONFIGURATION (NEVER used in deployed app code)
# ==============================================================================
# Required ONLY by offline administrative scripts (e.g. python scripts/seed_content.py)
# to bypass RLS and populate curriculum tables (worlds, levels, words, level_words).
# SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key-here"
